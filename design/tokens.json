  "elevation": {
    "$comment": "Dark mode builds hierarchy with surface tones + hairlines (no heavy shadows — low-end GPU discipline from the B critique); light mode adds a soft shadow on raised surfaces.",
    "dark": "surface tone steps + line.default hairlines; glass overlay uses surface.overlay + backdrop-filter with solid fallback",
    "light": "card/raised white + border line.default + shadow 0 1px 2px rgba(24,24,27,0.06), 0 4px 12px rgba(24,24,27,0.06)"
  },
