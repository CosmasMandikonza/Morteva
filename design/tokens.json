  "motion": {
    "duration": {
      "instant": "150ms",
      "fast": "180ms",
      "measured": "420ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "micro": "ease"
    },
    "stagger": {
      "list": "40ms",
      "listSlow": "80ms"
    },
    "reducedMotion": {
      "rule": "under prefers-reduced-motion: reduce, every animation/transition duration becomes 0.01ms (design-lab base.css gate); entrance staggers collapse to 0",
