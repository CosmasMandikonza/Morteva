  "statusSemantics": {
    "$comment": "The financial status ladder (apps/web/src/design-lab/lab/format.ts LADDER). Never color-only: every state renders glyph + text + tone. Green (verified) is reserved exclusively for provider-verified terminal states; SUBMITTED/IN-FLIGHT is amber and never reads as settled.",
    "ladder": [
      {
        "state": "PROPOSED",
        "tone": "neutral",
        "ink": "ink.secondary",
        "glyph": "○",
        "meaning": "draft — no funds touched"
      },
      {
        "state": "RESERVED",
        "tone": "info",
        "ink": "info.text",
        "background": "info.soft",
        "glyph": "◇",
        "meaning": "internal hold — not provider escrow"
      },
      {
        "state": "APPROVED",
        "tone": "info",
        "ink": "info.text",
        "background": "info.soft",
        "glyph": "✓",
        "meaning": "exact terms signed by digest"
      },
      {
        "state": "SUBMITTING",
        "tone": "transit",
        "ink": "status.transit.text",
        "background": "status.transit.background",
        "glyph": "▲",
        "meaning": "dispatching — do not close"
      },
      {
        "state": "SUBMITTED",
        "tone": "transit",
        "ink": "status.transit.text",
        "background": "status.transit.background",
        "glyph": "▲",
        "meaning": "in flight — NOT settled"
      },
      {
        "state": "STATUS_UNKNOWN",
        "tone": "hold",
        "ink": "status.hold.text",
        "background": "status.hold.background",
        "glyph": "⚠",
        "meaning": "commitment retained · verify by original ID"
      },
      {
        "state": "SETTLED",
        "tone": "verified",
        "ink": "status.verified.text",
        "background": "status.verified.background",
        "glyph": "●",
        "meaning": "provider-verified"
      },
      {
        "state": "RECONCILED",
        "tone": "verified",
        "ink": "status.verified.text",
        "background": "status.verified.background",
        "glyph": "◎",
        "meaning": "fees + outcome reconciled"
      },
      {
        "state": "REJECTED",
        "tone": "danger",
        "ink": "status.danger.text",
        "background": "status.danger.background",
        "glyph": "✕",
        "meaning": "blocked before spend"
      },
      {
        "state": "EXPIRED",
        "tone": "neutral",
        "ink": "ink.tertiary",
        "glyph": "⌛",
        "meaning": "authority lapsed"
      }
    ]
  },
  "typography": {
    "$comment": "Identity stack from candidate B; all three families SIL OFL 1.1, self-hosted via @fontsource-variable npm packages (verified in apps/web/package.json by the checker). IBM Plex families remain design-lab dependencies (candidate A reference), not part of the production system.",
    "family.display": {
      "value": "'Space Grotesk Variable', 'Space Grotesk', sans-serif",
      "package": "@fontsource-variable/space-grotesk",
      "use": "headings, screen titles, hero figures"
    },
    "family.ui": {
      "value": "'Inter Variable', 'Inter', system-ui, sans-serif",
      "package": "@fontsource-variable/inter",
      "use": "body, labels, controls, tables"
    },
    "family.mono": {
      "value": "'Geist Mono Variable', 'Geist Mono', ui-monospace, monospace",
      "package": "@fontsource-variable/geist-mono",
      "use": "ALL financial numerals, currency amounts, IDs, timestamps — monospaced digits guarantee tabular alignment"
    },
    "numeric.feature": {
      "value": "font-variant-numeric: tabular-nums",
      "use": "any numeric run rendered in family.ui (fallback when mono is not used); currency codes are always explicit (USD 2,150.00), never bare symbols"
    },
    "size": {
      "2xs": {
        "value": "0.64rem",
        "use": "HUD stamps, dense captions (lab: 0.64)"
      },
      "xs": {
        "value": "0.72rem",
        "use": "eyebrows, table meta (lab: 0.7–0.74)"
      },
      "sm": {
        "value": "0.8rem",
        "use": "secondary text, chips (lab: 0.78–0.82)"
      },
      "md": {
        "value": "0.9rem",
        "use": "body (lab: 0.86–0.95)"
      },
      "lg": {
        "value": "1.2rem",
        "use": "h3 (lab: 1.2)"
      },
      "xl": {
        "value": "1.55rem",
        "use": "h2 (lab: 1.5–1.55)"
      },
      "2xl": {
        "value": "1.9rem",
        "use": "h1 (lab: 1.9)"
      },
      "3xl": {
        "value": "2.9rem",
        "use": "hero spendable figure (lab: 2.9)"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "tracking": {
      "caps": {
        "value": "0.12em",
        "use": "uppercase micro-labels (lab: 0.1–0.18em)"
      },
      "hud": {
        "value": "0.34em",
        "use": "HUD stamps only (lab: 0.34em)"
      },
      "displayTight": {
        "value": "-0.02em",
        "use": "display headings (lab: -0.01 to -0.02em)"
      }
    }
  },
  "spacing": {
    "$comment": "4px base grid, normalized from lab usage.",
    "base": "4px",
    "scale": [4, 8, 12, 16, 20, 24, 32, 48]
  },
  "radius": {
    "hairline": "2px",
    "control": "4px",
    "card": "7px",
    "panel": "10px",
    "panelLarge": "12px",
    "pill": "999px",
    "$comment": "normalized from lab values 2/3/4/7/9/10/11/12/14"
  },
