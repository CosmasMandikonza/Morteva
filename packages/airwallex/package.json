{
  "name": "@moterva/airwallex",
  "version": "0.1.0",
  "private": true,
  "description": "Airwallex sandbox adapter: server-only auth, balances, transfers, FX quotes, readback and receipt persistence. DISABLED unless sandbox credentials are configured; offline fixture strictly for tests. No settlement claims without verified readback (issue #5).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke:balance": "node dist/smoke/balance.js",
    "smoke:transfer": "node dist/smoke/transfer.js"
  },
  "dependencies": {
    "@moterva/domain": "0.1.0",
    "@moterva/providers": "0.1.0",
    "@moterva/ledger": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
