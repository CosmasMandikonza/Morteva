# MOTERVA environment template — VARIABLE NAMES ONLY.
# Copy to .env for local runs and fill values locally. .env is gitignored;
# never commit real credentials to this public repository (see AGENTS.md).

# --- apps/api (server) -------------------------------------------------------
# Development-only env file loading uses `node --env-file-if-exists=.env`.
# All variables below are OPTIONAL; safe defaults are shown in comments.

# Node runtime environment: development | test | production
#NODE_ENV=development

# HTTP port for the API server (default 8787)
#PORT=8787

# Bind host (default 127.0.0.1; use 0.0.0.0 only inside a private container network)
#HOST=127.0.0.1

# Allowed browser origin for CORS (default http://localhost:5173 — the Vite dev server)
#WEB_ORIGIN=http://localhost:5173

# Local scenario-data mode in MTV-01 (not a single global banking rail). Allowed: offline | simulated.
# 'offline' (default): no provider adapters are wired; status honestly reports OFFLINE.
# 'simulated': same, plus DEMO_SIMULATED labeling of synthetic data.
# 'sandbox' and 'testnet' are intentionally rejected here. Future provider rails are
# independent: AIRWALLEX_ENV=sandbox and METAL_NETWORK=testnet can run together.
#MOTERVA_PROVIDER_MODE=offline

# Log level: trace | debug | info | warn | error (default info)
#LOG_LEVEL=info

# Financial ledger SQLite file (MTV-02). Relative paths resolve against the API
# working directory; the directory is created if needed. The file is gitignored.
#MOTERVA_LEDGER_PATH=data/moterva.sqlite

# Session lifetime for authenticated API actors in milliseconds (default 8h).
#MOTERVA_SESSION_TTL_MS=28800000

# DEMO_AUTH (MTV-05): enables username/password login + one-time dev bootstrap
# for local development ONLY. Refuses to boot if combined with NODE_ENV=production.
#MOTERVA_DEV_AUTH=1

# Optional build provenance surfaced by /healthz in CI
#GIT_SHA=

# --- Airwallex sandbox (issue #5 / MTV-03) — SERVER-SIDE ONLY, never commit ----
# The adapter is DISABLED unless ALL of AIRWALLEX_ENV=sandbox plus CLIENT_ID
# and API_KEY are present; half-configured sandbox refuses to boot. Until then
# the rail stays dark and status honestly reports the credential blocker.
#AIRWALLEX_ENV=sandbox
#AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
#AIRWALLEX_CLIENT_ID=
#AIRWALLEX_API_KEY=
# Server-side beneficiary id used for transfers (per-org override:
# AIRWALLEX_BENEFICIARY_ID_<orgId>), required before any transfer dispatch.
#AIRWALLEX_BENEFICIARY_ID=
# Read-only connection proof (smoke:connection) optional single-read targets:
#AIRWALLEX_SANDBOX_BENEFICIARY_ID=
#AIRWALLEX_SANDBOX_TRANSFER_ID=

# --- Reserved for issue #6 (Metal testnet) — NOT read by MTV-01 --------------
# Server-side only. Same rule as above.
#METAL_NETWORK=testnet
#METAL_RPC_URL=
#METAL_WALLET_ADDRESS=
#METAL_SIGNER_KEY=

# --- Production identity (MTV-19, ADR 0006) — SERVER-SIDE ONLY, never commit --
# All-or-nothing: partial configuration refuses startup. Production requires
# https issuer/redirect; plain-HTTP loopback issuers are allowed ONLY with
# MOTERVA_OIDC_ALLOW_INSECURE_TRANSPORT=1 outside production (local test IdP).
#MOTERVA_OIDC_ISSUER=https://idp.example.com
#MOTERVA_OIDC_CLIENT_ID=
#MOTERVA_OIDC_CLIENT_SECRET=
#MOTERVA_OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# Space-separated; must include openid (default: openid profile email)
#MOTERVA_OIDC_SCOPES=openid profile email
# Required ID-token signing algorithm (default RS256; anything else rejected)
#MOTERVA_OIDC_ID_TOKEN_ALG=RS256
# Authorization-flow state TTL, 60000-900000 ms (default 600000)
#MOTERVA_OIDC_FLOW_TTL_MS=600000
# IdP HTTP deadline for discovery + token exchange, 1000-30000 ms (default 10000)
#MOTERVA_OIDC_HTTP_TIMEOUT_MS=10000
# Plain-HTTP loopback test identity provider ONLY; production refuses it
#MOTERVA_OIDC_ALLOW_INSECURE_TRANSPORT=1
# Trust X-Forwarded-Proto from the TLS termination proxy (Caddy edge); enable
# ONLY when the API is not directly internet-exposed. Default 0.
#MOTERVA_TRUST_PROXY=1

# REVIEWER_DEMO (issues #17/#19): hosted reviewer capability that admits the
# FIXED signed synthetic scenario (baseline/incident) through the validated
# ingest pipeline. Requires a configured production identity (MOTERVA_OIDC_*)
# — startup refuses this flag without identity, and the routes do not exist
# (404) when unset. Never enables dev auth, provider spending or authority
# bypass; CSRF + per-actor rate limits + strict ownership apply.
#MOTERVA_REVIEWER_DEMO=1
