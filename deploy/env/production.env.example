# MOTERVA deployment environment — VARIABLE NAMES ONLY.
# Copy to deploy/env/production.env (gitignored) and fill in on the host.
# Never commit real values; provider credentials stay in secret storage (#5).

# Exact deployed git SHA — provenance surfaced by /healthz and image tags.
MOTERVA_RELEASE_SHA=

# Public HTTPS origin of THIS deployment (browser-facing). CORS allowlist.
MOTERVA_PUBLIC_ORIGIN=https://moterva-demo.example.org

# DNS name Caddy answers on with automatic TLS.
# Staging/local: use `localhost` (internal self-signed certificate).
MOTERVA_DOMAIN=moterva-demo.example.org

# ACME account email for Let's Encrypt (production TLS). Empty for staging.
ACME_EMAIL=

# API log level: info | warn | error
MOTERVA_LOG_LEVEL=info

# Deliberately ABSENT from this template (fail-closed by design):
#   MOTERVA_DEV_AUTH    — refused with NODE_ENV=production at boot
#   MOTERVA_PROVIDER_MODE — offline by default
#   AIRWALLEX_* / METAL_* — no credentials configured; rails stay disabled
