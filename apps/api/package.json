{
  "name": "@moterva/api",
  "version": "0.1.0",
  "private": true,
  "description": "MOTERVA API server. Honest health/read-only status; boots the local SQLite ledger (MTV-02) with migrations and integrity verification. Financial mutations stay internal — no public financial routes.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@moterva/domain": "0.1.0",
    "@moterva/ledger": "0.1.0",
    "@moterva/providers": "0.1.0",
    "fastify": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
